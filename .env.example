# Bot credentials — copy this file to .env and fill it in.
# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# General > Application ID
CLIENT_ID=

# Optional. If set, slash commands are registered to this server only
# (instant updates, best for testing). Leave empty to register globally.
GUILD_ID=

# Embed accent colour (decimal or #hex)
EMBED_COLOR=#5865F2
